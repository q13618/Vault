# 在 Vercel 项目里创建 Blob 存储并关联后，平台会自动注入这个变量。
# 本地开发时执行 `vercel env pull` 拉取，或手动粘贴。
BLOB_READ_WRITE_TOKEN=

# 可选：保护定时清理接口。在 Vercel 里设置后，Cron 会自动带上 Bearer 头。
CRON_SECRET=

# 可选：匿名用户单文件上限（MB），默认 200。
VAULT_ANON_MAX_MB=200

# 可选：站点规范域名，分享链接一律用它（例：f.airppp.com）。
# 不设时，生产部署会自动采用 Vercel 的生产域名，本地则用当前访问地址。
VAULT_CANONICAL_HOST=

# 网页转 PDF：Cloudflare Browser Rendering 的凭据。
# Token 需要 Browser Rendering: Edit 权限；不配置时该功能在界面上会说明原因。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
